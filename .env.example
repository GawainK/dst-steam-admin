# 复制为 .env 并按需修改（.env 已被 .gitignore 忽略，不会提交）。
# docker compose 会自动读取本目录下的 .env 做变量替换。

# 后台 Basic Auth 凭据（admin-web 容器使用）。
# 未设置 BASIC_AUTH_PASSWORD 时 admin-web 会拒绝启动，避免无鉴权暴露到公网。
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me

# 可选：轻量运行镜像（不含游戏），搭配 docker-compose.image.yml 与 --no-build 使用。
# 发布工作流启用前请勿直接使用此占位标签。
# DST_GAME_IMAGE=ghcr.io/gawaink/dst-steam-admin/dst-server:sha-<SHA前12位>
